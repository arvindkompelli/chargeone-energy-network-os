# ==========================================
# ChargeOne Energy Network OS - Environment Example
# ==========================================

# Port for Express API server
PORT=5173

# Node environment ('development' | 'production')
NODE_ENV=development

# Allowed CORS client origin (frontend dev server URL)
CLIENT_ORIGIN=http://localhost:3000

# Google Gemini API Key (Required for AI copilot, triage, and geospatial maps grounding)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Application base URL (used for OAuth callbacks, webhooks, and public endpoints)
APP_URL=http://localhost:5173

# Frontend API Target (Vite dev server proxy to backend)
VITE_API_URL=http://localhost:5173

# Disable HMR (set to true only in constrained sandbox environments)
DISABLE_HMR=false

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:root@localhost:5432/chargeone?schema=public"
